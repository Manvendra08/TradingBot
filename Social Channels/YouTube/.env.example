# Social Channels/YouTube/.env.example

# LLM Providers (at least one is required)
OMNIROUTER_BASE_URL=http://localhost:20128/v1
OMNIROUTER_API_KEY=your_omnirouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# TTS Voice Settings (optional - defaults to en-IN-PrabhatNeural)
YOUTUBE_TTS_VOICE=en-IN-PrabhatNeural

# YouTube Settings
YOUTUBE_PRIVACY_STATUS=private
