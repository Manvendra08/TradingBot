# NSEBOT — git ignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environment (keep only .venv)
venv/
.venv/
.venv-*/
.venv_new/
env/

# Environment / secrets
.env
*.env.local
data/.fernet_key
*.fernet_key
.fernet_key

# SQLite database (local data — don't commit)
data/*.db
data/*.db-shm
data/*.db-wal
data/*.bak*
*.bak*

# Logs
logs/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Streamlit
.streamlit/

# Test coverage artifacts — never commit these
.coverage
coverage.xml
htmlcov/
.pytest_cache/

# Cleanup backups
cleanup_backup_*/
backup_safe_delete_*/

# Runtime cache and sentinel data
data/cache/*
data/sentinel/*

# Generated reports and artifacts
docs/reports/*
!docs/reports/.gitkeep

# Kilo temporary investigation scripts
.kilo/tmp_*.py

# Test media assets
test_*.jpg
test_*.jpeg
test_*.gif
test_*.png
test_*.mp4
test_*.webm

# Scratch directory (keep folder, ignore contents)
scratch/*
!scratch/.gitkeep

# Cache directories (keep only active yf-cache)
data/yf-cache[2-9]/
data/yf-cache[0-9][0-9]/

# Database backups and journals
data/*.backup
data/*.db-journal

# Debug outputs and screenshots
*.png
paper_out.html

# Archive files
*.zip

# Local backups & large data
Backup/
Proceeding without questions/
data/dhan_scrip_master.csv
.kiro/

# Backup codebase snapshot (full project copy)
Codebase/

# Service account credentials (secrets)
data/google_drive_service_account.json

# Runtime state files
data/ip_state.json
data/shoonya_ip_state.json
data/runtime_config.json

# ML model artifacts
data/models/

# Broker token caches
shoonya_shared_token.json

# Root-level DB artifacts
nsebot.db
nse_bot.db
bot.db
*.db
*.db-shm
*.db-wal
nul

# Scratch test outputs
test_*.txt

# Coverage data
.coverage


# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# YouTube Generator Output
Social Channels/YouTube/output/
Social Channels/YouTube/pipeline.log
