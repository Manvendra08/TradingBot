{
  "_doc": "Decision matrix configuration for Indian markets (Indices & MCX). Hot reloaded.",
  "version": "2.0.0",
  "mode": "enforce",
  "vol_buckets": {
    "_doc": "ATM IV percentile cutoffs for vol regime classification. Low: <25, Mid: 25-70, High: >70",
    "low_max": 25.0,
    "mid_min": 25.0,
    "mid_max": 70.0,
    "high_min": 70.0,
    "lookback_days": 30,
    "min_samples": 10,
    "fallback_bucket": "HIGH"
  },
  "regime_table": {
    "_doc": "Direction x Vol bucket -> ordered allowed structure set (first entry is default)",
    "NEUTRAL": {
      "LOW": [
        "SHORT_STRANGLE"
      ],
      "MID": [
        "IRON_CONDOR",
        "SHORT_STRANGLE"
      ],
      "HIGH": [
        "IRON_CONDOR"
      ]
    },
    "BULLISH": {
      "LOW": [
        "NO_TRADE"
      ],
      "MID": [
        "BULL_PUT_SPREAD"
      ],
      "HIGH": [
        "BULL_PUT_SPREAD",
        "JADE_LIZARD"
      ]
    },
    "BEARISH": {
      "LOW": [
        "NO_TRADE"
      ],
      "MID": [
        "BEAR_CALL_SPREAD"
      ],
      "HIGH": [
        "BEAR_CALL_SPREAD"
      ]
    }
  },
  "overrides": {
