  "telegram": {
    "_doc": "Telegram formatting settings",
    "verbosity": "compact",
    "events": {
      "digest_line": true,
      "entry": true,
      "exit": true,
      "skip": true,
      "config": true
    },
    "skip_cooldown_min": 30
